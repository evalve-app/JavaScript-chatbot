# Copy to backend/.env and fill in. Never commit the real .env.

# Your own OpenAI key.
OPENAI_API_KEY=sk-...

# The team's shared Neon database (ask a teammate for it).
# Neon shows "postgresql://..."; change the start to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/studybot?sslmode=require

# Optional
OPENAI_MODEL=gpt-4o-mini
HISTORY_LIMIT=10
